{
  "name": "dev-browser-mcp",
  "version": "0.0.1",
  "type": "module",
  "description": "Model-facing MCP server and CLI for dev-browser (stdio + streamable HTTP)",
  "bin": {
    "dev-browser": "./bin/dev-browser.mjs"
  },
  "scripts": {
    "mcp": "npx tsx src/cli.ts mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "snapshot-tools": "npx tsx src/tool-snapshot.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.0"
  }
}
